# Copy this file to .env and fill in only what you use. .env is git-ignored.
# Real environment variables override values in .env.

# OpenAI-compatible LLM (fallback after local Ollama). Leave empty to use Ollama only.
OPENAI_API_KEY=
# Optional: any OpenAI-compatible endpoint, e.g. https://openrouter.ai/api/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Web search. Without keys Mika falls back to DuckDuckGo (no key needed).
TAVILY_API_KEY=
BRAVE_API_KEY=
